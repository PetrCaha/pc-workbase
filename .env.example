# Reference only; Django reads the process environment, not this file automatically.
DEBUG=false
SECRET_KEY=replace-with-a-private-random-value-at-least-50-characters
DATABASE_URL=postgresql://pc_workbase_reader:YOUR_PASSWORD@YOUR_NEON_HOST/pc_workbase?sslmode=require
ALLOWED_HOSTS=workbase.petrcaha.cz
